# extracted game content (Ankama assets — never commit or redistribute)
game/content/
!game/content/.gdignore

# Godot
game/.godot/
*.import
*.uid.bak

# tools output
tools/golden/out/
__pycache__/
*.pyc

# distribution (tools/build_release.py)
dist/

# donnees derivees du contenu Ankama / JondoEmu : jamais publiees (le serveur les lit en local)
game/data/
game/worlds/*
# the Vertebre world is original (no Ankama asset): its sources are worlds_src/vertebre, its output is committed
!game/worlds/vertebre/
# ...except the Dofus bones/skins/portraits/icons that gen/dofus_skin.py copies in from game/content (Ankama assets, never committed)
game/worlds/vertebre/Content/Characters/Bones/*
!game/worlds/vertebre/Content/Characters/Bones/95*/
game/worlds/vertebre/Content/Characters/Skins/
game/worlds/vertebre/Content/Picto/Monsters/*.webp
game/worlds/vertebre/Content/Picto/Items/*.webp
game/mods/
game/*.png
game/*.png.import
saves/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# atelier (site d edition de mondes)
atelier/node_modules/
game/worlds/vertebre/**/*.bak

atelier/web/dist/
atelier/screenshots/
atelier/world_ranges.json
game/worlds/vertebre/Content/UI/classes/*.webp
game/worlds/vertebre/Content/UI/classes/heads/big/*.webp
game/worlds/vertebre/Content/Maps/Gfx/*.webp
