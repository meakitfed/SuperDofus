# extracted game content (Ankama assets — never commit or redistribute)
game/content/
!game/content/.gdignore

# Godot
game/.godot/
*.import
*.uid.bak

# tools output
tools/golden/out/
__pycache__/
*.pyc

# distribution (tools/build_release.py)
dist/

# donnees derivees du contenu Ankama / JondoEmu : jamais publiees (le serveur les lit en local)
game/data/
game/worlds/*
# the Vertebre world is original (no Ankama asset): its sources are worlds_src/vertebre, its output is committed
!game/worlds/vertebre/
game/mods/
game/*.png
game/*.png.import
saves/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# atelier (site d edition de mondes)
atelier/node_modules/
game/worlds/vertebre/**/*.bak
