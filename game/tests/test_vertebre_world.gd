## The Vertebre world (worlds/vertebre, generated by worlds_src/vertebre/gen): it loads, offers its five classes,
## its NPCs talk and offer their quests, the stairs lead where they say, every asset the data names exists.
## Driven through LocalBackend -> GameSession like a client. Skipped when the world is not generated.
extends TestCase

const WORLD := "vertebre"
const HUB := 9001
const CLASSES := [901, 902, 903, 904, 905]


class Conn:
	var backend := LocalBackend.new()
	var events: Array = []
	var npcs := {} # npc id -> actor id
	var groups: Array = []
	var map := 0

	func _init(server: LocalServer, account := "local") -> void:
		backend.server = server
		backend.account = account
		backend.event.connect(func(ev: Dictionary) -> void:
			events.append(ev)
			if ev["t"] == Protocol.MAP_ENTER:
				map = int(ev["map"]["id"]) if ev.get("map") is Dictionary else int(ev.get("map", 0))
				npcs.clear()
				groups.clear()
				for a: Dictionary in ev["actors"]:
					if a["kind"] == "npc":
						npcs[int(a["npc"])] = int(a["id"])
					elif a["kind"] == "monster_group":
						groups.append(int(a["id"])))

	func send(cmd: Dictionary) -> Array:
		events = []
		backend.send(cmd)
		backend.poll(0.0)
		return events

	func take(type: String) -> Array:
		return events.filter(func(e: Dictionary) -> bool: return e["t"] == type)


func _enter() -> bool:
	if not ContentSource.dir_exists("worlds/%s/data" % WORLD):
		skip("world %s not generated" % WORLD)
		return false
	ContentSource.use_world(WORLD)
	return true


func _leave() -> void:
	ContentSource.use_dev()


## A connection playing a new character of `breed` (account `acc`), standing on the hub.
func _play(server: LocalServer, breed: int, name: String, acc := "local") -> Conn:
	var c := Conn.new(server, acc)
	c.send(Protocol.hello(WORLD))
	var made := c.send(Protocol.create_character(name, breed)).filter(func(e: Dictionary) -> bool: return e["t"] == Protocol.CHARACTER_CREATED)
	if made.is_empty():
		fail("class %d: character not created (%s)" % [breed, c.events])
		return c
	c.send(Protocol.hello(WORLD, name))
	return c


func test_the_world_loads() -> void:
	if not _enter():
		return
	var source := LocalServer.new().source_of(WORLD)
	check(source != null, "world source")
	if source != null:
		var info := source.get_info()
		eq(int(info["start_map"]), HUB)
		eq((info["maps"] as Array).size(), 12, "maps")
	_leave()


func test_each_class_can_be_created_and_played() -> void:
	if not _enter():
		return
	var server := LocalServer.new()
	var names := ["Aldo", "Bera", "Cato", "Dana", "Edro"]
	for i in CLASSES.size():
		var breed: int = CLASSES[i]
		var c := _play(server, breed, names[i], "acc%d" % breed)
		var welcome := c.take(Protocol.WELCOME)
		check(not welcome.is_empty(), "class %d: welcome" % breed)
		eq(c.map, HUB, "class %d starts on the hub" % breed)
		check(c.npcs.size() >= 8, "class %d: the hub has its NPCs (%d)" % [breed, c.npcs.size()])
	_leave()


func test_the_hub_npcs_talk_and_offer_the_first_quest() -> void:
	if not _enter():
		return
	var server := LocalServer.new()
	var c := _play(server, 901, "Aldo")
	var orsolan := 0
	var tree: Dictionary = ContentSource.read_json("worlds/%s/dialogs.json" % WORLD)["dialogs"]
	for npc_id: int in c.npcs:
		if (tree.get(str(npc_id), {}) as Dictionary).get("nodes", {}).has("aveu"):
			orsolan = npc_id
	check(orsolan != 0, "Orsolan is on the hub")
	var actor: int = c.npcs.get(orsolan, -1)
	var cell := -1
	var npc_rows: Dictionary = ContentSource.read_json("worlds/%s/npcs.json" % WORLD)["maps"]
	for row: Dictionary in npc_rows[str(HUB)]:
		if int(row["npc"]) == orsolan:
			cell = int(row["cell"])
	c.send(Protocol.move(MapGeometry.neighbors(cell)[0], false))
	c.backend.poll(3.0) # walk there
	var out := c.send(Protocol.npc_talk(actor))
	var dlg := c.take(Protocol.DIALOG)
	check(not dlg.is_empty(), "the dialog opens (%s)" % [out])
	if not dlg.is_empty():
		var replies: Array = dlg[0]["replies"]
		check(replies.any(func(r: Dictionary) -> bool: return r.has("quest")), "the first quest is offered")
	_leave()


func test_the_black_gate_leads_to_the_first_floor() -> void:
	if not _enter():
		return
	var server := LocalServer.new()
	var c := _play(server, 903, "Bera")
	var tree: Dictionary = ContentSource.read_json("worlds/%s/dialogs.json" % WORLD)["dialogs"]
	var gate := 0
	for npc_id: int in c.npcs:
		var nodes: Dictionary = (tree.get(str(npc_id), {}) as Dictionary).get("nodes", {})
		if nodes.has("0") and "Porte Noire" in str(nodes["0"]["text"]):
			gate = npc_id
	check(gate != 0, "the gate keeper is on the hub")
	var rows: Array = ContentSource.read_json("worlds/%s/npcs.json" % WORLD)["maps"][str(HUB)]
	var cell := -1
	for row: Dictionary in rows:
		if int(row["npc"]) == gate:
			cell = int(row["cell"])
	c.send(Protocol.move(MapGeometry.neighbors(cell)[0], false))
	c.backend.poll(3.0)
	c.send(Protocol.npc_talk(c.npcs[gate]))
	var dlg := c.take(Protocol.DIALOG)
	check(not dlg.is_empty(), "the gate talks")
	if not dlg.is_empty():
		var reply_id := int((dlg[0]["replies"] as Array)[0]["id"])
		c.send(Protocol.dialog_reply(reply_id))
		eq(c.map, 9101, "the gate leads to the first floor")
		check(c.groups.size() >= 2, "the first floor has monster groups (%d)" % c.groups.size())
	_leave()


## Every asset the data names exists in the world's own Content (so a download without Dofus assets is whole).
func test_the_assets_the_data_names_exist() -> void:
	if not _enter():
		return
	var monsters: Dictionary = ContentSource.read_json("worlds/%s/monsters.json" % WORLD)
	for section: String in ["monsters", "bosses"]:
		for id: String in monsters[section]:
			for g: Dictionary in monsters[section][id]["grades"]:
				var bone := str(g["look"]).trim_prefix("{").get_slice("|", 0)
				check(ContentSource.exists("worlds/%s/Content/Characters/Bones/%s/bone.json" % [WORLD, bone]), "monster %s: bone %s" % [id, bone])
				check(ContentSource.exists("worlds/%s/Content/Picto/Monsters/%d.png" % [WORLD, int(g["portrait"])]), "monster %s: portrait" % id)
	for id: int in GameData.item_ids():
		if id >= 9_100_000:
			check(ContentSource.exists("worlds/%s/Content/Picto/Items/%d.png" % [WORLD, id]), "item %d: icon" % id)
	for mid: int in (ContentSource.read_json("worlds/%s/world.json" % WORLD) as Dictionary)["maps"]:
		check(ContentSource.exists("worlds/%s/Content/Content/Maps/%d.json" % [WORLD, int(mid)]) or ContentSource.exists("worlds/%s/Content/Maps/%d.json" % [WORLD, int(mid)]), "map %d: visual" % int(mid))
	_leave()


## The world's texts come through the i18n overlay (names of items, classes, quests) with no Dofus table.
func test_the_texts_resolve() -> void:
	if not _enter():
		return
	var any_item: Dictionary = GameData.item(9_100_001)
	check(not any_item.is_empty(), "the first item exists")
	var provider := ContentSourceProvider.new()
	DofusContent.set_provider(provider)
	check(DofusI18n.text(int(any_item["name_id"]), "") == str(any_item["name"]), "the name_id of an item resolves to its name")
	var breed := GameData.row("breeds", 901)
	check(DofusI18n.text(int(str(breed["shortNameId"])), "") == "Veilleur", "the class name resolves")
	_leave()
	DofusContent.set_provider(ContentSourceProvider.new())
