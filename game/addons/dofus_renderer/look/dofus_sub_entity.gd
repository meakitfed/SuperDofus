## Binding-point categories of sub entities (`cat@index={look}` in a look string).
class_name DofusSubEntity
extends RefCounted

enum Category {
	UNUSED = 0,
	PET = 1,
	MOUNT_DRIVER = 2,
	LIFTED_ENTITY = 3,
	BASE_BACKGROUND = 4,
	BASE_FOREGROUND = 6,
	PET_FOLLOWER = 7,
	UNDERWATER_BUBBLES = 8,
	RIDER_LEG = 9,
}
