{
  "name": "atelier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atelier de mondes SuperDofus : edition et validation de game/worlds/<id>/ sans toucher a Godot",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx core/cli.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/main.ts",
    "dev": "vite --config web/vite.config.ts",
    "shots": "tsx tests/shots.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
